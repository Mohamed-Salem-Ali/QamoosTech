    "ai": "node scripts/ai.mjs",
    "qa": "node scripts/qa-review.mjs",
    "terms": "node scripts/terms-agent.mjs",
    "qa-fix": "node scripts/qa-fix.mjs",
    "scan": "node scripts/scan-scripts.mjs",
    "enrich": "node scripts/enrich.mjs",
    "keywords": "node scripts/enrich-keywords.mjs",
    "dedupe": "node scripts/check-candidates.mjs",
