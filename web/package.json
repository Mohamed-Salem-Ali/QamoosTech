{
  "name": "qamoostech-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test tests/search.test.mjs tests/content.test.mjs",
    "predev": "npm run search-index",
